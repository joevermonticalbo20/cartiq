# CartIQ API - emulator demo env (SAFE TO COMMIT).
# No real secrets here. Dummy JWT secrets only.
# The real prod secrets live in api/.env (gitignored) and Supabase dashboard.
# This file is loaded by `npm run dev:emulator` ONLY. Never used in production.
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_PROJECT_ID="cartiq-8e46f"
JWT_SECRET="emulator-demo-secret-not-for-prod"
JWT_REFRESH_SECRET="emulator-demo-refresh-not-for-prod"
HOST=0.0.0.0
PORT=4000
# Allow local web dev servers without code edit. Add your LAN IP when demoing
# the dashboard from a phone/laptop browser, e.g.:
# CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://192.168.100.217:5173"
