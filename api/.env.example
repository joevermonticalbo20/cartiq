# CartIQ API environment - Firestore backend (Spark free tier)
# Copy to .env. NEVER commit .env or service-account JSON files.

# --- Firestore (pick ONE) ---
# Local emulator (free, no credentials, no quota): start with
#   firebase emulators:start --only firestore   (from repo root, port 8080)
# then set:
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Production / shared dev (real Firestore in cartiq-8e46f):
# Comment out FIRESTORE_EMULATOR_HOST and set these instead:
# FIREBASE_PROJECT_ID="cartiq-8e46f"
# GOOGLE_APPLICATION_CREDENTIALS="C:/path/to/service-account.json"
# (Generate the key in Cloud Console -> IAM & Admin -> Service Accounts.
#  Never commit it; .gitignore covers *.json keys via service-account*.json.)
# Hosted platforms with no key file (e.g. Supabase dashboard -> Secrets):
# paste the WHOLE service-account JSON as one env var instead:
# FIREBASE_SERVICE_ACCOUNT_JSON='<entire JSON on one line>'
# Cloud hosts without mDNS (Render): DISABLE_MDNS=true

JWT_SECRET="change-me-generate-with-node-crypto-randomBytes-32"

# Optional: separate refresh token secret (defaults to JWT_SECRET if omitted)
JWT_REFRESH_SECRET="change-this-in-production"

HOST=0.0.0.0

PORT=4000

# Browser origins for CORS. Override when your LAN IP/DHCP changes so the
# web dev server is allowed without a code edit.
# CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.16:5173"
# Production (Firebase Hosting): add your Hosting URLs, e.g.
# CORS_ORIGINS="https://cartiq-8e46f.web.app,https://cartiq-8e46f.firebaseapp.com"
