generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enums: string columns below carry app-level
// validation with the allowed values noted per field.

model User {
  id           Int       @id @default(autoincrement())
  name         String
  username     String    @unique
  passwordHash String
  // role: "OWNER" | "STAFF"
  role         String    @default("STAFF")
  active       Boolean   @default(true)
  rfidUid      String?   @unique
  locationId   Int?
  location     Location? @relation(fields: [locationId], references: [id])
  shifts       Shift[]
  orders       Order[]
  refreshTokens RefreshToken[]
  adjustments  StockAdjustment[]
  createdAt    DateTime  @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Location {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  name           String
  address        String?
  // status: "ACTIVE" | "INACTIVE"
  status         String          @default("ACTIVE")
  users          User[]
  orders         Order[]
  inventory      InventoryItem[]
  shifts         Shift[]
  sensorReadings SensorReading[]
  expenses       Expense[]
  devices        Device[]
  adjustments    StockAdjustment[]
}

// One ESP32 IoT node per cart. Dev tokens are bcrypt-hashed at rest.
model Device {
  id         Int       @id @default(autoincrement())
  deviceId   String    @unique
  locationId Int
  location   Location  @relation(fields: [locationId], references: [id])
  tokenHash  String
  active     Boolean   @default(true)
  lastSeenAt DateTime?
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String   @default("Fries")
  basePrice Float
  flavors   Flavor[]
}

model Flavor {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

// Recipe mapping used for automatic inventory deduction on paid orders.
// A row with flavor = "" applies to every flavor of the product;
// a flavor-specific row wins over the generic one.
model IngredientMap {
  id            Int     @id @default(autoincrement())
  productName   String
  // flavor: "" = all flavors
  flavor        String  @default("")
  itemName      String
  amountPerUnit Float

  @@unique([productName, flavor, itemName])
}

model InventoryItem {
  id         Int      @id @default(autoincrement())
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])
  name       String
  unit       String   @default("pcs")
  stock      Float
  threshold  Float    @default(0)
  // source: "MANUAL" | "SENSOR"
  source     String   @default("MANUAL")
  updatedAt  DateTime @updatedAt
  adjustments StockAdjustment[]

  @@unique([locationId, name])
}

// Audit trail for manual stock corrections (POST /inventory/adjustments).
// Every staff adjustment records actor + before/after; owner rows too.
model StockAdjustment {
  id              Int      @id @default(autoincrement())
  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  locationId      Int
  location        Location @relation(fields: [locationId], references: [id])
  actorId         Int
  actor           User     @relation(fields: [actorId], references: [id])
  before          Float
  after           Float
  reason          String?
  createdAt       DateTime @default(now())

  @@index([inventoryItemId, createdAt])
}

model Order {
  id         Int         @id @default(autoincrement())
  clientRef  String      @unique
  locationId Int
  location   Location    @relation(fields: [locationId], references: [id])
  staffId    Int?
  staff      User?       @relation(fields: [staffId], references: [id])
  total      Float
  // status: "PAID" | "VOID"
  status     String      @default("PAID")
  // paymentMethod: "CASH" | "GCASH" | "CARD" (nullable for legacy rows)
  paymentMethod String?
  // VOID audit (record-only; stock is NOT reversed on void)
  voidedBy   Int?
  voidedAt   DateTime?
  voidReason String?
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  syncedAt   DateTime    @default(now())

  @@index([locationId, createdAt])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id])
  productName String
  flavor      String?
  qty         Int
  unitPrice   Float
}

model Shift {
  id         Int      @id @default(autoincrement())
  staffUid   String
  staffId    Int?
  staff      User?    @relation(fields: [staffId], references: [id])
  staffName  String?
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])
  // event: "IN" | "OUT"
  event      String
  ts         DateTime
  deviceId   String?
  uploadedAt DateTime @default(now())

  @@index([locationId, ts])
}

model SensorReading {
  id         Int      @id @default(autoincrement())
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])
  // channel: "LPG_TANK" | "CHEESE_BIN"
  channel    String
  kg         Float
  ts         DateTime
  deviceId   String?
  uploadedAt DateTime @default(now())

  @@index([locationId, channel, ts])
}

model Expense {
  id         Int       @id @default(autoincrement())
  vendor     String
  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id])
  amount     Float
  date       DateTime
  // source: "OCR" | "MANUAL"
  source     String    @default("MANUAL")
  // category: "Supplies" | "LPG/Gas" | "Maintenance" | "Fees/Rent" | "Other"
  category   String    @default("Supplies")
  note       String?
  lines      String?   // JSON array of parsed receipt line items (vendor-side)
  createdAt  DateTime  @default(now())

  @@index([date])
}

model Supplier {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  contact String?
  notes   String?
}

model Alert {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  payload   String?
  isRead    Boolean  @default(false)
  // Staff acknowledgement (detected -> acknowledged -> resolved via isRead).
  ackedBy     Int?
  ackedAt     DateTime?
  ackedByName String?
  createdAt DateTime @default(now())
}
