# CartIQ mobile POS environment — REFERENCE ONLY, not read by Flutter.
# The app takes its API URL at build time via:
#   flutter run --dart-define=API_BASE_URL=<value below>
# or at runtime via the in-app Server row (boot splash / Login → Server),
# which persists the URL on-device and wins over everything else.
#
# Copy the value you need:

# Shared production backend (DEFAULT in lib/config.dart — same Firestore
# database as the web dashboard, no per-phone setup):
API_BASE_URL=https://cartiq-api-aswt.onrender.com/api

# Local development targets (pass ONE via --dart-define, or type in-app):
# API_BASE_URL=http://10.0.2.2:4000/api
# API_BASE_URL=http://127.0.0.1:4000/api
# API_BASE_URL=http://192.168.100.217:4000/api
