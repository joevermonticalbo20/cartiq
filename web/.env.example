# CartIQ web dashboard environment.
# Local dev needs NO file (Vite proxies /api to the local API automatically).
# Only create .env for special cases below. NEVER commit .env files.

# API base the dashboard calls.
# Default when unset: /api (same-origin; dev proxy + any same-host backend)
VITE_API_BASE=/api
# Production build (bakes into web/dist at build time):
# VITE_API_BASE=https://cartiq-api-aswt.onrender.com/api

# App Configuration
VITE_APP_NAME=CartIQ
VITE_APP_VERSION=0.1.0
